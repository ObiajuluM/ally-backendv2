# ---------------------------------------------------------------------------
# .dockerignore
# Works like .gitignore but for Docker.
# Files listed here are NOT copied into the image when Docker runs COPY . .
# Keeping secrets and junk out of the image makes it smaller and safer.
# ---------------------------------------------------------------------------

# Never bake secrets into the image — they're injected at runtime via env_file.
.env

# Git history is not needed inside the container.
.git
.gitignore

# Python cache files — Docker will regenerate them inside the container.
__pycache__
*.pyc
*.pyo

# Local SQLite database — production uses Postgres.
db.sqlite3

# Collected static files — entrypoint.sh runs collectstatic on startup.
staticfiles/

# Log files and macOS metadata junk.
*.log
.DS_Store

.venv
venv
*.md
tests/
.pytest_cache